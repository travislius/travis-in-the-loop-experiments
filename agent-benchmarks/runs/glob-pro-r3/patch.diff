+def _compile(pattern):
+    out = ['^']
+    i = 0
+    n = len(pattern)
+    while i < n:
+        c = pattern[i]
+        if c == '/':
+            out.append('/')
+            i += 1
+        elif c == '*' and _is_doublestar(pattern, i):
+            if i + 2 == n:
