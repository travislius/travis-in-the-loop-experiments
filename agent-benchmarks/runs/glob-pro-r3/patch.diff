+                # whole segments (so it never matches the directory itself).
+                out.append('[^/]+(?:/[^/]+)*')
+                i += 2
+            else:
+                # '**' followed by '/': zero or more whole segments.
+                out.append('(?:[^/]+/)*')
+                i += 3  # skip '**' and the following '/'
+        elif c == '\\' and i + 1 < n:
+            # A backslash escapes the next character.
+            out.append(re.escape(pattern[i + 1]))
+            i += 2
