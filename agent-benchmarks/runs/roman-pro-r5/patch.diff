+import re
+
 V = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000}
+
+# Standard subtractive form for 1-3999:
+#   thousands:  0-3 M
+#   hundreds:   CM | CD | D? C{0,3}
+#   tens:       XC | XL | L? X{0,3}
+#   ones:       IX | IV | V? I{0,3}
+_ROMAN_RE = re.compile(
+    r"M{0,3}(CM|CD|D?C{0,3})(XC|XL|L?X{0,3})(IX|IV|V?I{0,3})"
+)
+
+
 def from_roman(s):
+    if not isinstance(s, str):
+        raise ValueError("invalid Roman numeral: %r" % (s,))
+    s = s.upper()
+    if not s or not _ROMAN_RE.fullmatch(s):
+        raise ValueError("invalid Roman numeral: %r" % (s,))
