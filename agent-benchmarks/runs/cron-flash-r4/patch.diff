+"""Standard 5-field cron expression evaluation using only the standard library."""
+
+import bisect
 import datetime as dt
+
+
+def _parse_field(field, lo, hi, sunday_zero=False):
+    """Expand one cron field into the set of integer values it matches.
+
+    Supported syntax: ``*``, a single number, comma-separated lists, ranges
+    (``1-5``), and steps (``*/15`` or ``10-40/10``).  A bare ``n/step`` means
+    "from n through the end of the field".
+    """
+    if not isinstance(field, str) or not field:
+        raise ValueError("invalid cron field: %r" % (field,))
+
+    values = set()
+    for item in field.split(","):
+        item = item.strip()
+        if not item:
+            raise ValueError("invalid cron field: %r" % (field,))
+
+        step = 1
+        has_step = "/" in item
+        if has_step:
+            base, _, step_text = item.partition("/")
+            if not base or not step_text or "/" in step_text:
+                raise ValueError("invalid cron step: %r" % (item,))
+            try:
+                step = int(step_text, 10)
+            except ValueError:
+                raise ValueError("invalid cron step: %r" % (item,)) from None
+            if step <= 0:
+                raise ValueError("cron step must be positive: %r" % (item,))
+        else:
+            base = item
+
+        if base == "*":
+            start, end = lo, hi
+        elif "-" in base:
+            start_text, _, end_text = base.partition("-")
+            if not start_text or not end_text or "-" in end_text:
+                raise ValueError("invalid cron range: %r" % (item,))
+            try:
+                start = int(start_text, 10)
+                end = int(end_text, 10)
+            except ValueError:
+                raise ValueError("invalid cron range: %r" % (item,)) from None
+        else:
+            try:
+                start = int(base, 10)
+            except ValueError:
+                raise ValueError("invalid cron value: %r" % (item,)) from None
+            end = hi if has_step else start
+
+        if start < lo or end > hi:
+            raise ValueError(
+                "cron value out of range %d-%d: %r" % (lo, hi, item)
+            )
+        if start > end:
+            raise ValueError("descending cron range: %r" % (item,))
+
+        for value in range(start, end + 1, step):
+            # Day-of-week: 0-6 with 0 = Sunday, and 7 is an alias for Sunday.
+            values.add(0 if sunday_zero and value == 7 else value)
+
+    return values
+
+
+def _cron_weekday(day):
+    """Return the cron day-of-week for a date (Monday=0 in Python)."""
+    return (day.weekday() + 1) % 7
+
