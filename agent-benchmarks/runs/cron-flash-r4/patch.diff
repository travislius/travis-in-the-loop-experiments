+    """Return the first datetime strictly after *after* matching *expr*.
+
+    *expr* is a standard five-field cron expression
+    ``minute hour day-of-month month day-of-week``.  The result is a naive
+    datetime with seconds and microseconds set to zero.  A ``ValueError`` is
+    raised for an invalid expression or when no match exists within five
+    years.
+    """
+    fields = expr.split()
+    if len(fields) != 5:
+        raise ValueError("cron expression must have five fields: %r" % (expr,))
+
+    minute_f, hour_f, dom_f, month_f, dow_f = fields
+
+    minutes = _parse_field(minute_f, 0, 59)
+    hours = _parse_field(hour_f, 0, 23)
+    doms = _parse_field(dom_f, 1, 31)
+    months = _parse_field(month_f, 1, 12)
+    dows = _parse_field(dow_f, 0, 7, sunday_zero=True)
+
+    # Vixie cron: only a literal "*" makes a day field unrestricted.  When
+    # both day fields are restricted a day matches if EITHER matches;
+    # otherwise the restricted field alone applies.
+    dom_restricted = dom_f != "*"
+    dow_restricted = dow_f != "*"
+
+    times = sorted(hour * 60 + minute for hour in hours for minute in minutes)
+
+    # Seconds are dropped and the search starts at the next whole minute, so
+    # the result is always strictly after ``after``.
+    start = after.replace(second=0, microsecond=0) + dt.timedelta(minutes=1)
+    start_date = start.date()
+    start_minute = start.hour * 60 + start.minute
+
+    # 366 * 5 days also covers leap days and the five-year window requested.
+    for offset in range(366 * 5 + 1):
+        day = start_date + dt.timedelta(days=offset)
+        if day.month not in months:
+            continue
+
+        dom_match = day.day in doms
+        dow_match = _cron_weekday(day) in dows
+
+        if dom_restricted and dow_restricted:
+            day_match = dom_match or dow_match
+        else:
+            day_match = dom_match and dow_match
+
+        if not day_match:
+            continue
+
+        threshold = start_minute if offset == 0 else 0
+        index = bisect.bisect_left(times, threshold)
+        if index < len(times):
+            minute_of_day = times[index]
+            return dt.datetime(
+                day.year,
+                day.month,
+                day.day,
+                minute_of_day // 60,
+                minute_of_day % 60,
+            )
+
+    raise ValueError("no matching run found within five years: %r" % (expr,))
