+        if peek('('):
+            advance()
+            value = parse_expression()
+            expect(')')
+            return value
+        raise ValueError("malformed expression")
+
+    result = parse_expression()
+    if not peek('EOF'):
+        raise ValueError("malformed expression")
+    return result
+
