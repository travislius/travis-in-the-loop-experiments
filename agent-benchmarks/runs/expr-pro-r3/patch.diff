+    """Evaluate an arithmetic expression given as a string.
+
+    Supports integers and decimals (`3`, `0.5`, `.5`), the operators
+    `+ - * / ^`, parentheses, unary minus, and whitespace anywhere.
+    Precedence (highest first): `^`, unary minus, `* /`, then `+ -`.
+    `^` is right-associative; the others are left-associative.
+    """
+    tokens = _tokenize(s)
+    pos = 0
+
+    def peek(kind=None):
+        tok = tokens[pos][0]
+        if kind is None:
+            return tok
+        return tok == kind
+
+    def advance():
+        nonlocal pos
+        tok = tokens[pos]
+        pos += 1
+        return tok
+
+    def expect(kind):
+        tok = advance()
+        if tok[0] != kind:
+            raise ValueError("malformed expression")
+        return tok
+
+    def parse_expression():
+        value = parse_term()
+        while peek('+') or peek('-'):
+            op = advance()[0]
+            rhs = parse_term()
+            if op == '+':
+                value = value + rhs
+            else:
+                value = value - rhs
+        return value
+
+    def parse_term():
+        value = parse_factor()
+        while peek('*') or peek('/'):
+            op = advance()[0]
+            rhs = parse_factor()
+            if op == '*':
+                value = value * rhs
+            else:
+                value = value / rhs
+        return value
+
+    def parse_factor():
+        if peek('-'):
+            advance()
+            return -parse_factor()
+        return parse_power()
+
+    def parse_power():
+        base = parse_primary()
+        if peek('^'):
+            advance()
+            return base ** parse_factor()
+        return base
+
+    def parse_primary():
+        tok = tokens[pos]
+        if tok[0] == 'num':
+            advance()
