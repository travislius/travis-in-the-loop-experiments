+def _normalize_number(text):
+    """Convert a numeric string using either US or European conventions to float."""
+    # Keep only characters that can be part of a number; this strips currency
+    # symbols, currency codes (e.g. "EUR"), whitespace and other labels.
+    cleaned = re.sub(r"[^0-9.,+\-]", "", text)
+    cleaned = cleaned.replace("+", "").replace("-", "")
+
+    if not cleaned:
+        raise ValueError("no numeric value found in {!r}".format(text))
+
+    if "," in cleaned and "." in cleaned:
+        # Whichever separator comes last is the decimal separator.
+        if cleaned.rfind(",") > cleaned.rfind("."):
+            cleaned = cleaned.replace(".", "").replace(",", ".")
+        else:
+            cleaned = cleaned.replace(",", "")
+    elif "," in cleaned:
+        parts = cleaned.split(",")
+        if len(parts) > 2:
+            # Multiple commas: the last group is decimal only if it is not a
+            # three-digit group (otherwise they are all thousands separators).
+            if len(parts[-1]) == 3:
+                cleaned = "".join(parts)
+            else:
+                cleaned = "".join(parts[:-1]) + "." + parts[-1]
+        else:
+            whole, fraction = parts
+            if (
+                len(fraction) == 3
+                and whole not in ("", "0")
+                and len(whole) <= 3
+            ):
+                # Ambiguous single comma with three trailing digits ("1,234")
+                # is treated as a thousands separator; otherwise it is decimal.
+                cleaned = whole + fraction
+            else:
+                cleaned = (whole or "0") + "." + fraction
+    else:
+        parts = cleaned.split(".")
+        if len(parts) > 2:
+            # Multiple dots: use the same rule as for multiple commas.
+            if len(parts[-1]) == 3:
+                cleaned = "".join(parts)
+            else:
+                cleaned = "".join(parts[:-1]) + "." + parts[-1]
+
+    return float(cleaned)
+
