+"""A small recursive-descent evaluator for arithmetic expressions."""
+
+
+class _Parser:
+    def __init__(self, tokens):
+        self._tokens = tokens
+        self._pos = 0
+
+    def _peek(self):
+        return self._tokens[self._pos][0]
+
+    def _peek_value(self):
+        return self._tokens[self._pos][1]
+
+    def _advance(self):
+        token = self._tokens[self._pos]
+        self._pos += 1
+        return token
+
+    def parse(self):
+        if self._peek() == "eof":
+            raise ValueError("empty expression")
+        value = self._expression()
+        if self._peek() != "eof":
+            raise ValueError("unexpected token")
+        return value
+
+    def _expression(self):
+        value = self._term()
+        while self._peek() in ("+", "-"):
+            op = self._advance()[0]
+            rhs = self._term()
+            if op == "+":
+                value = value + rhs
+            else:
+                value = value - rhs
+        return value
+
+    def _term(self):
+        value = self._unary()
+        while self._peek() in ("*", "/"):
+            op = self._advance()[0]
+            rhs = self._unary()
+            if op == "*":
+                value = value * rhs
+            else:
+                value = value / rhs
+        return value
+
+    def _unary(self):
+        # Unary signs bind less tightly than exponentiation, so -2^2 == -4.
+        if self._peek() == "-":
+            self._advance()
+            return -self._unary()
+        if self._peek() == "+":
+            self._advance()
+            return self._unary()
+        return self._power()
+
+    def _power(self):
+        base = self._primary()
+        if self._peek() == "^":
+            self._advance()
+            # Recursing through _unary makes ^ right-associative and lets the
+            # exponent carry a sign (e.g. 2^-3).
+            exponent = self._unary()
+            return base ** exponent
+        return base
+
+    def _primary(self):
+        token = self._peek()
+        if token == "num":
+            return self._advance()[1]
+        if token == "(":
+            self._advance()
+            value = self._expression()
+            if self._peek() != ")":
+                raise ValueError("missing closing parenthesis")
+            self._advance()
+            return value
+        raise ValueError("expected a number or '('")
+
