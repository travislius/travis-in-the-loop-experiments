+    """Parse an amount from a bank export into a float.
+
+    Handles currency symbols/codes, thousands separators, accounting
+    negatives, and both US (1,234.50) and European (1.234,50) formats.
+    """
+    if isinstance(s, (int, float)):
+        return float(s)
+
+    text = str(s).strip()
+    if not text:
+        raise ValueError("empty amount")
+
+    # Normalize unicode minus signs before stripping non-numeric characters.
+    text = text.replace("\u2212", "-").replace("\u2013", "-").replace("\u2014", "-")
+
+    # Keep only characters meaningful to a number/accounting amount.
+    text = re.sub(r"[^\d.,+\-()]", "", text)
+    if not text:
+        raise ValueError("no numeric value in amount")
+
+    negative = False
+    if "(" in text or ")" in text:
+        negative = True
+    text = text.replace("(", "").replace(")", "")
+
+    if "-" in text:
+        negative = True
+    text = text.replace("-", "").replace("+", "")
+
+    last_dot = text.rfind(".")
+    last_comma = text.rfind(",")
+
+    if last_dot != -1 and last_comma != -1:
+        # Both separators are present: the rightmost one is the decimal
+        # separator and the other one groups thousands.
+        if last_dot > last_comma:
+            decimal_sep, thousands_sep = ".", ","
+        else:
+            decimal_sep, thousands_sep = ",", "."
+        text = text.replace(thousands_sep, "").replace(decimal_sep, ".")
+    elif last_dot != -1 or last_comma != -1:
+        sep = "." if last_dot != -1 else ","
+        parts = text.split(sep)
+
+        if len(parts) > 2:
+            # Repeated separator, e.g. 1.234.567: normally thousands
+            # grouping. If the final group is not three digits, treat the
+            # final group as the fractional part instead.
+            if len(parts[-1]) == 3 and all(len(p) == 3 for p in parts[1:-1]):
+                text = "".join(parts)
+            else:
+                text = "".join(parts[:-1]) + "." + parts[-1]
+        else:
+            left, right = parts
+            # A single separator followed by exactly three digits is a
+            # thousands separator (e.g. 1,234), unless there is no integer
+            # part or it has a leading zero (e.g. 0,123 is decimal).
+            if right and len(right) == 3 and left and len(left) <= 3 and not left.startswith("0"):
+                text = left + right
+            else:
+                text = left + "." + right
+
+    value = float(text)
+    return -value if negative else value
