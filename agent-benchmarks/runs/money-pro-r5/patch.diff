+    """Parse a monetary amount from a bank-export string into a float.
+
+    Handles US style ("$1,234.50"), accounting negatives ("(1,234.50)"),
+    plain negatives ("-12") and European style ("1.234,50 €", "EUR 3,5").
+    """
+    text = s.strip()
+
+    # Accounting-style negatives wrap the amount in parentheses.
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1]
+
+    # A minus sign anywhere marks a negative amount.
+    if "-" in text:
+        negative = True
+        text = text.replace("-", "")
+
+    # Keep only digits and the two possible separators.
+    text = re.sub(r"[^0-9.,]", "", text)
+
+    if not text:
+        raise ValueError("could not parse amount: %r" % (s,))
+
+    decimal_sep, thousands_sep = _separators(text)
+
+    if thousands_sep:
+        text = text.replace(thousands_sep, "")
+    if decimal_sep:
+        text = text.replace(decimal_sep, ".")
+
+    value = float(text)
+    return -value if negative else value
+
+
+def _separators(digits):
+    """Return (decimal_separator, thousands_separator) for the given digits."""
+    if "." in digits and "," in digits:
+        # Whichever separator comes last is the decimal separator, which works
+        # for both US ("1,234.50") and European ("1.234,50") styles.
+        if digits.rfind(",") > digits.rfind("."):
+            return ",", "."
+        return ".", ","
+    if "," in digits:
+        parts = digits.split(",")
+        # A trailing group of exactly three digits reads as a thousands
+        # separator; otherwise the comma is a decimal comma ("EUR 3,5").
+        if len(parts[-1]) == 3 and all(len(p) == 3 for p in parts[1:]):
+            return None, ","
+        return ",", None
+    if "." in digits:
+        parts = digits.split(".")
+        if len(parts[-1]) == 3 and all(len(p) == 3 for p in parts[1:]):
+            return None, "."
+        return ".", None
+    return None, None
