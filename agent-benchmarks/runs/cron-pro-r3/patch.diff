+def _parse_field(field, lo, hi):
+    """Parse one cron field into a set of allowed values, or None for ``*``.
+
+    Supports ``*``, single numbers, lists (``1,15,30``), ranges (``1-5``)
+    and steps (``*/15``, ``10-40/10``).
+    """
+    if field == "*":
+        return None
+
+    values = set()
+    for part in field.split(","):
+        step = 1
+        if "/" in part:
+            base, step_str = part.split("/", 1)
+            step = int(step_str)
+        else:
+            base = part
+
+        if base == "*":
+            start, end = lo, hi
+        elif "-" in base:
+            start_str, end_str = base.split("-", 1)
+            start, end = int(start_str), int(end_str)
+        else:
+            start = end = int(base)
+
+        if step <= 0:
+            raise ValueError("cron step must be a positive integer")
+
+        for value in range(start, end + 1, step):
+            values.add(value)
+
+    return values
+
+
+def _cron_weekday(day):
+    """Return the cron day-of-week for a date (0 = Sunday ... 6 = Saturday)."""
+    # dt.date.weekday() is Monday=0 ... Sunday=6, so shift it.
+    return (day.weekday() + 1) % 7
+
+
+def _day_matches(day, doms, dows):
+    """Apply the Vixie-cron day-of-month / day-of-week matching rule."""
+    dom_restricted = doms is not None
+    dow_restricted = dows is not None
+
+    dom_ok = day.day in doms if dom_restricted else False
+    dow_ok = _cron_weekday(day) in dows if dow_restricted else False
+
+    if dom_restricted and dow_restricted:
+        return dom_ok or dow_ok
+    if dom_restricted:
+        return dom_ok
+    if dow_restricted:
+        return dow_ok
+    return True
+
