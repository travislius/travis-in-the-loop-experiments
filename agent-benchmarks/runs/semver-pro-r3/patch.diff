+    if a is None:
+        return 1  # A version without pre-release has higher precedence.
+    if b is None:
+        return -1
+    for x, y in zip(a, b):
+        result = _compare_identifier(x, y)
+        if result:
+            return result
+    if len(a) == len(b):
+        return 0
+    # A larger set of pre-release fields has higher precedence when all
+    # preceding identifiers are equal.
+    return 1 if len(a) > len(b) else -1
+
