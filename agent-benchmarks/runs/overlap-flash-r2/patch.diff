 def overlaps(a_start, a_end, b_start, b_end):
-    """Return True if the inclusive date ranges overlap."""
-    return a_start < b_end and b_start < a_end
+    """Return True if the inclusive date ranges overlap.
+
+    Both endpoints of a range are occupied, so ranges that merely touch
+    (e.g. ``[1, 5]`` and ``[5, 9]``) do overlap.  Endpoints may be supplied
+    in either order, and the two ranges may be supplied in either order.
+    """
+    # Normalise each range so its endpoints can be given in any order.
+    if a_start > a_end:
+        a_start, a_end = a_end, a_start
+    if b_start > b_end:
+        b_start, b_end = b_end, b_start
+
+    # Inclusive comparison: touching ranges share a day.
+    return a_start <= b_end and b_start <= a_end
