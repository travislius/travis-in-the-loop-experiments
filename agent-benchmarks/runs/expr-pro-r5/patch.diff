+            value = parse_expression()
+            skip_ws()
+            if pos >= n or s[pos] != ")":
+                raise ValueError("malformed expression")
+            pos += 1
+            return value
+        if is_digit(c) or c == ".":
+            return parse_number()
+        raise ValueError("malformed expression")
+
+    def parse_power():
