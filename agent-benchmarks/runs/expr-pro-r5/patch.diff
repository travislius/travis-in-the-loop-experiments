+    """
+    pos = 0
+    n = len(s)
+
+    def is_digit(c):
+        return "0" <= c <= "9"
+
+    def skip_ws():
+        nonlocal pos
+        while pos < n and s[pos].isspace():
+            pos += 1
+
+    def parse_number():
