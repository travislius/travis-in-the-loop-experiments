+def _parse_class(pattern, start):
+    """Parse a character class beginning at *start*.
+
+    Returns ``(end, predicate)`` where *end* is the index just past the
+    closing bracket, or ``None`` when the text is not a valid class (in
+    which case the ``[`` is treated as a literal character).
+    """
+    length = len(pattern)
+    i = start + 1
+
+    negate = False
+    if i < length and pattern[i] == "!":
+        negate = True
+        i += 1
+
+    items = []  # (character, was_escaped)
+    first = True
+    while i < length:
+        char = pattern[i]
+
+        if char == "\\" and i + 1 < length:
+            items.append((pattern[i + 1], True))
+            i += 2
+            first = False
+            continue
+
+        if char == "]":
+            # A ']' immediately after '[' or '[!' is a literal member.
+            if first:
+                items.append(("]", False))
+                i += 1
+                first = False
+                continue
+            break
+
+        items.append((char, False))
+        i += 1
+        first = False
+    else:
+        return None
+
+    if i >= length or pattern[i] != "]" or not items:
+        return None
+
+    # Turn the item list into literal characters and ranges.
+    ranges = []
+    index = 0
+    while index < len(items):
+        if (
+            index + 2 < len(items)
+            and items[index + 1][0] == "-"
+            and not items[index + 1][1]
+        ):
+            ranges.append((items[index][0], items[index + 2][0]))
+            index += 3
+        else:
+            ranges.append((items[index][0], None))
+            index += 1
+
+    def predicate(char):
+        if char == "/":
+            return False
+
+        found = False
+        for low, high in ranges:
+            if high is None:
+                if char == low:
+                    found = True
+                    break
+            elif low <= char <= high:
+                found = True
+                break
+
+        return not found if negate else found
+
+    return i + 1, predicate
+
