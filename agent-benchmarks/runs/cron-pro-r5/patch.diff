+def _parse_field(field, lo, hi):
+    """Parse one cron field into a set of allowed integer values.
+
+    Supports ``*``, single numbers, lists (``1,15,30``), ranges (``1-5``)
+    and steps (``*/15``, ``10-40/10``).
+    """
+    values = set()
+    for part in field.split(","):
+        if not part:
+            raise ValueError("empty element in cron field %r" % field)
+        base, sep, step_str = part.partition("/")
+        if sep:
+            step = int(step_str)
+        else:
+            step = 1
+        if step <= 0:
+            raise ValueError("step must be a positive integer in %r" % field)
+
+        if base == "*":
+            start, end = lo, hi
+        elif "-" in base:
+            start_str, _, end_str = base.partition("-")
+            start, end = int(start_str), int(end_str)
+        else:
+            start = end = int(base)
+
+        if start < lo or end > hi:
+            raise ValueError("value out of range [%d, %d] in %r" % (lo, hi, field))
+        if start > end:
+            raise ValueError("range start greater than end in %r" % field)
+
+        values.update(range(start, end + 1, step))
+    return values
+
+
+def _day_matches(day, dom_restricted, dow_restricted, doms, dows):
+    dom_ok = day.day in doms
+    # Python: Monday == 0.  Cron: Sunday == 0.
+    dow_ok = ((day.weekday() + 1) % 7) in dows
+
+    if dom_restricted and dow_restricted:
+        return dom_ok or dow_ok
+    if dom_restricted:
+        return dom_ok
+    if dow_restricted:
+        return dow_ok
+    return True
+
