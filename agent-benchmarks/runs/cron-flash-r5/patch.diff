+    """Return the first minute strictly after ``after`` matching ``expr``.
+
+    ``after`` must be a naive :class:`datetime.datetime`; seconds and
+    microseconds are dropped.  Raises :class:`ValueError` if no matching
+    time exists within five years.
+    """
+    if not isinstance(after, dt.datetime):
+        raise TypeError("after must be a datetime.datetime")
+
+    (minutes, hours, days, months, weekdays,
+     dom_restricted, dow_restricted) = _parse(expr)
+
+    # Drop seconds/microseconds, then advance one whole minute so the
+    # result is strictly after ``after``.
+    start = after.replace(second=0, microsecond=0) + dt.timedelta(minutes=1)
+    start_date = start.date()
+
+    # Search up to five years ahead.  Guard against Feb 29 in the target
+    # year by falling back to Feb 28.
+    try:
+        end_date = start_date.replace(year=start_date.year + 5)
+    except ValueError:
+        end_date = start_date.replace(year=start_date.year + 5,
+                                      month=2, day=28)
+
+    sorted_hours = sorted(hours)
+    sorted_minutes = sorted(minutes)
+    day = start_date
+
+    while day <= end_date:
+        if day.month in months and _day_matches(
+                day, days, weekdays, dom_restricted, dow_restricted):
+            if day == start_date:
+                earliest = start.hour * 60 + start.minute
+            else:
+                earliest = 0
+
+            for hour in sorted_hours:
+                for minute in sorted_minutes:
+                    if hour * 60 + minute >= earliest:
+                        return dt.datetime.combine(day,
+                                                   dt.time(hour, minute))
+
+        day += dt.timedelta(days=1)
+
+    raise ValueError("no run time found within five years for %r" % expr)
