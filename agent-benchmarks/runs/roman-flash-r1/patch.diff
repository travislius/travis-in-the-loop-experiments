+def to_roman(n):
+    """Convert an integer in 1..3999 to its standard subtractive Roman form."""
+    if not isinstance(n, int) or isinstance(n, bool) or not (1 <= n <= 3999):
+        raise ValueError("value out of range (1..3999)")
+    out = []
+    for value, symbol in _NUMERALS:
+        while n >= value:
+            out.append(symbol)
+            n -= value
+    return "".join(out)
