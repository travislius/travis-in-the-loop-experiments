+import calendar
 import datetime as dt
+
+
+def _parse_field(field, lo, hi):
+    """Parse one cron field into a set of allowed integer values.
+
+    Supports '*', single numbers, lists ('1,15,30'), ranges ('1-5') and
+    steps ('*/15', '10-40/10', or '5/10' meaning from 5 to the maximum).
+    """
+    values = set()
+    for part in field.split(','):
+        values.update(_parse_part(part, lo, hi))
+    return values
+
+
+def _parse_part(part, lo, hi):
+    step = 1
+    if '/' in part:
+        part, _, step_text = part.partition('/')
+        step = int(step_text)
+        if step <= 0:
+            raise ValueError('cron step must be a positive integer')
+
+    if part == '*':
+        start, end = lo, hi
+    elif '-' in part:
+        start_text, _, end_text = part.partition('-')
+        start, end = int(start_text), int(end_text)
+    else:
+        start = end = int(part)
+
+    if start < lo or end > hi:
+        raise ValueError('cron value out of range')
+    return set(range(start, end + 1, step))
+
+
+def _days_in_month(year, month):
+    return calendar.monthrange(year, month)[1]
+
+
+def _cron_weekday(year, month, day):
+    """Return the cron day-of-week for a date (0 = Sunday ... 6 = Saturday)."""
+    return (dt.date(year, month, day).weekday() + 1) % 7
+
+
+def _day_matches(year, month, day, doms, dows, dom_restricted, dow_restricted):
+    """Apply the Vixie-cron day matching rule.
+
+    When BOTH day-of-month and day-of-week are restricted, a day matches if
+    EITHER field matches; otherwise only the restricted field (if any) counts.
+    """
+    if dom_restricted and dow_restricted:
+        return day in doms or _cron_weekday(year, month, day) in dows
+    if dom_restricted:
+        return day in doms
+    if dow_restricted:
+        return _cron_weekday(year, month, day) in dows
+    return True
+
