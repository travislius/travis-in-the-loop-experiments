+def _is_decimal_separator(text, sep, position):
+    """Decide whether the only ``sep`` in ``text`` is a decimal point.
+
+    A single separator followed by exactly three digits is normally a
+    thousands separator (``1,234`` / ``1.234``), except for values such as
+    ``0.123`` where the leading zero makes the decimal interpretation clear.
+    """
+    if text.count(sep) != 1:
+        return False
+
+    before = text[:position].lstrip("+-")
+    after = text[position + 1:]
+    if not before or not after:
+        return True
+
+    if len(after) == 3 and 1 <= len(before) <= 3 and not before.startswith("0"):
+        return False
+    return True
+
