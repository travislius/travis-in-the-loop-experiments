+    """Parse a monetary amount from common bank-export formats.
+
+    Supports US and European grouping/decimal separators, currency symbols
+    and codes, leading minus signs, and accounting negatives in parentheses.
+    """
+    text = str(s).strip()
+
+    negative = False
+    if text.startswith("(") and text.endswith(")"):
+        negative = True
+        text = text[1:-1].strip()
+
+    if "-" in text or "\u2212" in text:
+        negative = True
+
+    # Keep only digits and decimal/grouping separators; currency symbols,
+    # codes (EUR, USD, ...), spaces, and signs are discarded.
+    number = re.sub(r"[^0-9.,]", "", text)
+    if not any(ch.isdigit() for ch in number):
+        raise ValueError("could not parse amount: {!r}".format(s))
+
+    has_dot = "." in number
+    has_comma = "," in number
+
+    if has_dot and has_comma:
+        # The rightmost separator is the decimal separator.
+        decimal_sep = "." if number.rfind(".") > number.rfind(",") else ","
+    elif has_dot:
+        decimal_sep = "." if _is_decimal_separator(number, ".", number.rfind(".")) else None
+    elif has_comma:
+        decimal_sep = "," if _is_decimal_separator(number, ",", number.rfind(",")) else None
+    else:
+        decimal_sep = None
+
+    if decimal_sep is None:
+        number = re.sub(r"[.,]", "", number)
+    else:
+        other_sep = "," if decimal_sep == "." else "."
+        number = number.replace(other_sep, "").replace(decimal_sep, ".")
+
+    try:
+        amount = float(number)
+    except ValueError:
+        raise ValueError("could not parse amount: {!r}".format(s))
+
+    return -amount if negative else amount
