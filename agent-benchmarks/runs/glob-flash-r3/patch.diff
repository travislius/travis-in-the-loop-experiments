+def _parse_class_char(pattern, index):
+    """Return (character, next_index, was_escaped) for a class atom."""
+    if pattern[index] == "\\" and index + 1 < len(pattern):
+        return pattern[index + 1], index + 2, True
+    return pattern[index], index + 1, False
+
+
+def _parse_class(pattern, start):
+    """Parse a bracket expression beginning at ``start``.
+
+    Returns the token and the index just past the expression.  If the
+    expression is not terminated, '[' is treated as an ordinary character.
+    """
+    index = start + 1
+    negate = False
+    if index < len(pattern) and pattern[index] == "!":
+        negate = True
+        index += 1
+
+    items = []
+    first_item = True
+    closed = False
+    while index < len(pattern):
+        if pattern[index] == "]" and not first_item:
+            closed = True
+            index += 1
+            break
+
+        char, next_index, escaped = _parse_class_char(pattern, index)
+
+        # A '-' starts a range only if it is unescaped and has an endpoint.
+        if (
+            not escaped
+            and next_index < len(pattern)
+            and pattern[next_index] == "-"
+            and next_index + 1 < len(pattern)
+            and pattern[next_index + 1] != "]"
+        ):
+            end, after_end, _ = _parse_class_char(pattern, next_index + 1)
+            items.append(("range", char, end))
+            index = after_end
+        else:
+            items.append(("char", char))
+            index = next_index
+
+        first_item = False
+
+    if not closed:
+        return ("lit", "["), start + 1
+
+    return ("class", negate, items), index
+
+
+def _tokenize(pattern):
+    """Turn a glob pattern into a flat list of matching tokens."""
+    segments = []
+    current = []
+    index = 0
+
+    while index < len(pattern):
+        char = pattern[index]
+
+        if char == "\\":
+            if index + 1 < len(pattern):
+                escaped = pattern[index + 1]
+                if escaped == "/":
+                    segments.append(current)
+                    current = []
+                else:
+                    current.append(("lit", escaped))
+                index += 2
+            else:
+                current.append(("lit", "\\"))
+                index += 1
+        elif char == "/":
+            segments.append(current)
+            current = []
+            index += 1
+        elif char == "*":
+            end = index
+            while end < len(pattern) and pattern[end] == "*":
+                end += 1
+            current.append(("dstar",) if end - index == 2 else ("star",))
+            index = end
+        elif char == "?":
+            current.append(("qmark",))
+            index += 1
+        elif char == "[":
+            token, index = _parse_class(pattern, index)
+            current.append(token)
+        else:
+            current.append(("lit", char))
+            index += 1
+
+    segments.append(current)
+
+    # '**' is special only when it is an entire path segment.  Elsewhere
+    # consecutive stars behave like a single '*'.
+    for segment in segments:
+        if len(segment) == 1 and segment[0][0] == "dstar":
+            continue
+        for position, token in enumerate(segment):
+            if token[0] == "dstar":
+                segment[position] = ("star",)
+
+    tokens = []
+    for position, segment in enumerate(segments):
+        if position:
+            tokens.append(("slash",))
+        tokens.extend(segment)
+    return tokens
+
+
+def _class_matches(negate, items, char):
+    matched = False
+    for item in items:
+        if item[0] == "char":
+            if char == item[1]:
+                matched = True
+                break
+        else:
+            if item[1] <= char <= item[2]:
+                matched = True
+                break
+    return matched != negate
+
