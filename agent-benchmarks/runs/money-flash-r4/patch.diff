+    """Parse an amount from a bank export and return it as a float.
+
+    Handles US and European number formats, currency symbols/codes,
+    accounting negatives in parentheses, and leading/trailing signs.
+    """
+    if s is None:
+        raise ValueError("amount is required")
+
+    text = str(s).strip()
+    if not text:
+        raise ValueError("empty amount")
+
+    negative = False
+
+    # Accounting negatives: "(1,234.50)" or "($1,234.50)".
+    if "(" in text and ")" in text:
+        negative = True
+        text = text.replace("(", "").replace(")", "")
+
+    # Normalize Unicode minus/dash characters.
+    text = text.replace("\u2212", "-").replace("\u2013", "-").replace("\u2014", "-")
+
+    # A sign may appear before or after the number/currency.
+    if "-" in text:
+        negative = True
+        text = text.replace("-", "")
+    text = text.replace("+", "")
+
+    # Keep only digits and separators; this drops currency symbols, ISO
+    # codes, whitespace (including non-breaking spaces), and apostrophes.
+    cleaned = re.sub(r"[^0-9.,]", "", text)
+    if not cleaned or not re.search(r"\d", cleaned):
+        raise ValueError("invalid amount: {!r}".format(s))
+
+    last_dot = cleaned.rfind(".")
+    last_comma = cleaned.rfind(",")
+
+    if last_dot != -1 and last_comma != -1:
+        # Both separators are present: the rightmost one is the decimal
+        # separator and the other is the thousands separator.
+        decimal_sep = "." if last_dot > last_comma else ","
+        thousands_sep = "," if decimal_sep == "." else "."
+        integer, fraction = cleaned.rsplit(decimal_sep, 1)
+        integer = integer.replace(decimal_sep, "").replace(thousands_sep, "")
+        fraction = fraction.replace(decimal_sep, "").replace(thousands_sep, "")
+        normalized = integer + "." + fraction
+    else:
+        sep = "." if last_dot != -1 else ("," if last_comma != -1 else None)
+        if sep is None:
+            normalized = cleaned
+        else:
+            parts = cleaned.split(sep)
+            if len(parts) > 2:
+                # Repeated separator: grouping, unless the last group is
+                # not a normal three-digit group (then it is a decimal).
+                if len(parts[-1]) == 3:
+                    normalized = "".join(parts)
+                else:
+                    normalized = "".join(parts[:-1]) + "." + parts[-1]
+            else:
+                before, after = parts
+                if not after:
+                    raise ValueError("invalid amount: {!r}".format(s))
+                # A lone separator followed by exactly three digits is
+                # thousands grouping ("1,234" / "1.234"); otherwise it is
+                # a decimal separator ("3,5" / "12.50").
+                grouping = (
+                    len(after) == 3
+                    and 1 <= len(before) <= 3
+                    and set(before) != {"0"}
+                )
+                if grouping:
+                    normalized = before + after
+                else:
+                    normalized = before + "." + after
+
+    value = float(normalized)
+    return -value if negative else value
