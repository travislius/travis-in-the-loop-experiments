+"""Semantic Versioning 2.0.0 precedence comparison."""
+
+import re
+
+# A pre-release/build identifier is a dot-separated sequence of ASCII
+# alphanumerics and hyphens.  A numeric identifier must not have leading zeros.
+_NUMERIC_IDENTIFIER = re.compile(r"^(?:0|[1-9]\d*)$")
+_ALPHANUMERIC_IDENTIFIER = re.compile(r"^[0-9A-Za-z-]+$")
+
+
+def _parse(version):
+    """Return ``(major, minor, patch, prerelease)`` for *version*.
+
+    Build metadata is validated but deliberately discarded, since SemVer
+    gives it no role in precedence.  ``prerelease`` is a list of identifiers,
+    or ``None`` when the version has no pre-release part.
+    """
+    if not isinstance(version, str):
+        raise TypeError("version must be a string")
+
+    # Build metadata may itself contain hyphens, so remove it before looking
+    # for the pre-release separator.
+    core_and_prerelease = version.split("+", 1)[0]
+
+    if "+" in version:
+        build = version.split("+", 1)[1]
+        if not build:
+            raise ValueError("empty build metadata in {!r}".format(version))
+        for identifier in build.split("."):
+            if not identifier or not _ALPHANUMERIC_IDENTIFIER.match(identifier):
+                raise ValueError(
+                    "invalid build identifier {!r} in {!r}".format(
+                        identifier, version
+                    )
+                )
+
+    if "-" in core_and_prerelease:
+        core, prerelease_text = core_and_prerelease.split("-", 1)
+        prerelease = prerelease_text.split(".")
+        for identifier in prerelease:
+            if not identifier or not _ALPHANUMERIC_IDENTIFIER.match(identifier):
+                raise ValueError(
+                    "invalid pre-release identifier {!r} in {!r}".format(
+                        identifier, version
+                    )
+                )
+            if identifier.isdigit() and not _NUMERIC_IDENTIFIER.match(identifier):
+                raise ValueError(
+                    "numeric pre-release identifier {!r} has a leading zero "
+                    "in {!r}".format(identifier, version)
+                )
+    else:
+        core = core_and_prerelease
+        prerelease = None
+
+    parts = core.split(".")
+    if len(parts) != 3:
+        raise ValueError(
+            "version {!r} must have major, minor and patch components".format(
+                version
+            )
+        )
+
+    numbers = []
+    for part in parts:
+        if not part.isdigit() or not _NUMERIC_IDENTIFIER.match(part):
+            raise ValueError(
+                "invalid numeric version component {!r} in {!r}".format(
+                    part, version
+                )
+            )
+        numbers.append(int(part))
+
+    return numbers[0], numbers[1], numbers[2], prerelease
+
+
+def _compare_prerelease(left, right):
+    """Compare two pre-release identifier lists according to SemVer."""
+    # A version with a pre-release has lower precedence than one without.
+    if left is None and right is None:
+        return 0
+    if left is None:
+        return 1
+    if right is None:
+        return -1
+
+    for left_identifier, right_identifier in zip(left, right):
+        left_is_numeric = left_identifier.isdigit()
+        right_is_numeric = right_identifier.isdigit()
+
+        if left_is_numeric and right_is_numeric:
+            left_number = int(left_identifier)
+            right_number = int(right_identifier)
+            if left_number != right_number:
+                return -1 if left_number < right_number else 1
+        elif left_is_numeric != right_is_numeric:
+            # Numeric identifiers always have lower precedence than
+            # alphanumeric identifiers.
+            return -1 if left_is_numeric else 1
+        else:
+            if left_identifier != right_identifier:
+                return -1 if left_identifier < right_identifier else 1
+
+    # All shared identifiers are equal; the longer list has higher precedence.
+    if len(left) != len(right):
+        return -1 if len(left) < len(right) else 1
     return 0
+
+
+def compare(a, b):
+    """Compare two semantic versions and return -1, 0 or 1.
+
+    Implements the precedence rules from SemVer 2.0.0.  Build metadata is
+    ignored, so versions that differ only in build metadata compare equal.
+    """
+    a_major, a_minor, a_patch, a_prerelease = _parse(a)
+    b_major, b_minor, b_patch, b_prerelease = _parse(b)
+
+    for a_number, b_number in (
+        (a_major, b_major),
+        (a_minor, b_minor),
+        (a_patch, b_patch),
+    ):
+        if a_number != b_number:
+            return -1 if a_number < b_number else 1
+
+    return _compare_prerelease(a_prerelease, b_prerelease)
