+def _parse_core(version):
+    # Strip build metadata (ignored for precedence).
+    if "+" in version:
+        version = version.split("+", 1)[0]
+    # Split off pre-release.
+    if "-" in version:
+        core, pre = version.split("-", 1)
+        pre = pre.split(".")
+    else:
+        core, pre = version, []
+    major, minor, patch = core.split(".")
+    return (int(major), int(minor), int(patch)), pre
+
+
+def _cmp_pre(a, b):
+    # No pre-release has higher precedence than any pre-release.
+    if not a and not b:
+        return 0
+    if not a:
+        return 1
+    if not b:
+        return -1
+    for x, y in zip(a, b):
+        nx, ny = x.isdigit(), y.isdigit()
+        if nx and ny:
+            xi, yi = int(x), int(y)
+            if xi != yi:
+                return -1 if xi < yi else 1
+        elif nx:
+            # Numeric identifiers have lower precedence.
+            return -1
+        elif ny:
+            return 1
+        else:
+            if x != y:
+                return -1 if x < y else 1
+    # All shared identifiers equal: longer pre-release has higher precedence.
+    if len(a) != len(b):
+        return -1 if len(a) < len(b) else 1
     return 0
+
+
+def compare(a, b):
+    core_a, pre_a = _parse_core(a)
+    core_b, pre_b = _parse_core(b)
+    if core_a < core_b:
+        return -1
+    if core_a > core_b:
+        return 1
+    return _cmp_pre(pre_a, pre_b)
