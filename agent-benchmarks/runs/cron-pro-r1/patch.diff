+def _parse_item(item, lo, hi):
+    """Parse one field item (number, range, or step) into a set of integers."""
+    step = 1
+    if "/" in item:
+        item, step_s = item.split("/", 1)
+        step = int(step_s)
+        if step <= 0:
+            raise ValueError("step must be positive")
+    if item == "*":
+        start, end = lo, hi
+    elif "-" in item:
+        start_s, end_s = item.split("-", 1)
+        start, end = int(start_s), int(end_s)
+    else:
+        start = end = int(item)
+    if start < lo or end > hi or start > end:
+        raise ValueError("field value out of range")
+    return set(range(start, end + 1, step))
+
+
+def _parse_field(field, lo, hi):
+    """Return ``(allowed, restricted)`` for a numeric cron field.
+
+    ``restricted`` is False only when the field is a bare ``*``.
+    """
+    if field == "*":
+        return set(range(lo, hi + 1)), False
+    values = set()
+    for item in field.split(","):
+        values |= _parse_item(item, lo, hi)
+    return values, True
+
+
+def _parse_dow(field):
+    """Parse day-of-week: 0-6 with 0 = Sunday, and 7 is an alias for 0."""
+    if field == "*":
+        return set(range(7)), False
+    values = set()
+    for item in field.split(","):
+        for v in _parse_item(item, 0, 7):
+            values.add(0 if v == 7 else v)
+    return values, True
+
+
+def _day_matches(date, dom, dom_restricted, dow, dow_restricted):
+    """Apply the standard Vixie-cron day-of-month / day-of-week rule."""
+    dom_ok = date.day in dom
+    dow_ok = ((date.weekday() + 1) % 7) in dow
+    if dom_restricted and dow_restricted:
+        return dom_ok or dow_ok
+    if dom_restricted:
+        return dom_ok
+    if dow_restricted:
+        return dow_ok
+    return True
+
+
+def _next_time(minutes, hours, threshold):
+    """Smallest minute-of-day >= threshold with an allowed hour and minute."""
+    for h in sorted(hours):
+        if h < threshold // 60:
+            continue
+        minute_from = threshold % 60 if h == threshold // 60 else 0
+        for m in sorted(minutes):
+            if m >= minute_from:
+                return h * 60 + m
+    return None
+
