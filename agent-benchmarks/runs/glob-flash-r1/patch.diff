+    Returns ``(regex_fragment, next_index)`` or ``None`` when the '[' does not
+    begin a valid character class (in which case it is treated literally).
+    """
+    n = len(pattern)
+    i = start + 1
+
+    negated = False
+    if i < n and pattern[i] == "!":
+        negated = True
+        i += 1
+
