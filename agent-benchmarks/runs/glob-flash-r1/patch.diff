+def _class_range_endpoint(char):
+    """Return an unambiguous regex character-class range endpoint."""
+    code = ord(char)
+    if code <= 0xFF:
+        return "\\x%02x" % code
+    if code <= 0xFFFF:
+        return "\\u%04x" % code
+    return "\\U%08x" % code
+
+
+def _parse_class(pattern, start):
+    """Parse a character class beginning at *start*.
