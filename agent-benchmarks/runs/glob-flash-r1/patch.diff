+    raw = []
+    first = True
+    closed = False
+    while i < n:
+        char = pattern[i]
+
+        if char == "\\":
+            if i + 1 >= n:
+                return None
+            raw.append((pattern[i + 1], True))
+            i += 2
+            first = False
+            continue
+
+        if char == "]":
+            if first:
+                # A ']' immediately after '[' (or '[!') is a literal member.
+                raw.append(("]", False))
+                i += 1
+                first = False
+                continue
+            closed = True
+            i += 1
+            break
+
+        raw.append((char, False))
+        i += 1
+        first = False
+
