+"""Semantic Versioning 2.0.0 precedence comparison."""
+
+import re
+
+_NUMERIC = re.compile(r"^[0-9]+$")
+
+
+def _parse(version):
+    """Return (core, prerelease) for a version, ignoring build metadata.
+
+    ``core`` is a tuple of three integers and ``prerelease`` is either a
+    string or ``None`` when the version has no pre-release part.
+    """
+    if not isinstance(version, str):
+        raise TypeError("version must be a string")
+
+    # Build metadata starts at the first '+' and never affects precedence.
+    without_build = version.split("+", 1)[0]
+
+    # The pre-release part starts at the first '-' after the core version.
+    core_text, separator, prerelease = without_build.partition("-")
+
+    core_parts = core_text.split(".")
+    if len(core_parts) != 3 or not all(_NUMERIC.match(part) for part in core_parts):
+        raise ValueError("invalid semantic version: {!r}".format(version))
+
+    core = tuple(int(part) for part in core_parts)
+    return core, (prerelease if separator else None)
+
+
+def _compare_prerelease(a, b):
+    """Compare two pre-release strings according to SemVer 2.0.0."""
+    if a is None and b is None:
+        return 0
+    # A version without a pre-release has higher precedence than one with it.
+    if a is None:
+        return 1
+    if b is None:
+        return -1
+
+    a_ids = a.split(".")
+    b_ids = b.split(".")
+
+    for a_id, b_id in zip(a_ids, b_ids):
+        if a_id == b_id:
+            continue
+
+        a_numeric = _NUMERIC.match(a_id) is not None
+        b_numeric = _NUMERIC.match(b_id) is not None
+
+        # Numeric identifiers always have lower precedence than
+        # alphanumeric identifiers.
+        if a_numeric and b_numeric:
+            a_value, b_value = int(a_id), int(b_id)
+            return -1 if a_value < b_value else 1
+        if a_numeric:
+            return -1
+        if b_numeric:
+            return 1
+
+        # Alphanumeric identifiers are compared in ASCII sort order.
+        return -1 if a_id < b_id else 1
+
+    # A larger set of pre-release fields has higher precedence when all of
+    # the preceding identifiers are equal.
+    return (len(a_ids) > len(b_ids)) - (len(a_ids) < len(b_ids))
+
