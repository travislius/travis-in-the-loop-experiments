+                # preceding one, but never the preceding path itself.
+                if not previous_globstar:
+                    parts.append("/")
+                parts.append("[^/]+(?:/[^/]+)*")
+                previous_globstar = False
+            else:
+                if not previous_globstar:
+                    parts.append("/")
+                parts.append("(?:[^/]+/)*")
+                previous_globstar = True
+        else:
+            if not previous_globstar:
+                parts.append("/")
+            parts.append(_translate_segment(segment))
+            previous_globstar = False
+
+    return "".join(parts)
+
