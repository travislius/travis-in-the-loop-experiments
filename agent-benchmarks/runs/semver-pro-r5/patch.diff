+def _cmp_identifier(x, y):
+    """Compare two pre-release identifiers per SemVer 2.0.0 precedence."""
+    x_numeric = x.isdigit()
+    y_numeric = y.isdigit()
+
+    # Numeric identifiers always have lower precedence than alphanumeric ones.
+    if x_numeric and y_numeric:
+        return _sign(int(x) - int(y))
+    if x_numeric:
+        return -1
+    if y_numeric:
+        return 1
+
+    # Both are alphanumeric: compare in ASCII sort order.
+    if x < y:
+        return -1
+    if x > y:
+        return 1
+    return 0
+
