+def _parse_field(field, lo, hi):
+    """Parse a single cron field into a set of allowed integer values.
+
+    Supports '*', single numbers, lists, ranges, and steps such as
+    '*/15' or '10-40/10'.
+    """
+    values = set()
+    for part in field.split(','):
+        part = part.strip()
+        if not part:
+            raise ValueError("empty item in cron field")
+
+        step = 1
+        if '/' in part:
+            base, step_text = part.split('/', 1)
+            step = int(step_text)
+            if step <= 0:
+                raise ValueError("step must be positive")
+        else:
+            base = part
+
+        if base == '*':
+            start, end = lo, hi
+        elif '-' in base:
+            start_text, end_text = base.split('-', 1)
+            start, end = int(start_text), int(end_text)
+        else:
+            start = end = int(base)
+
+        if start < lo or end > hi or start > end:
+            raise ValueError("value out of range in cron field")
+
+        values.update(range(start, end + 1, step))
+
+    return values
+
+
+def _parse_dow(field):
+    """Parse the day-of-week field; 7 is an alias for Sunday (0)."""
+    values = _parse_field(field, 0, 7)
+    if 7 in values:
+        values.remove(7)
+        values.add(0)
+    return values
+
+
+def _add_years(day, years):
+    try:
+        return day.replace(year=day.year + years)
+    except ValueError:
+        # day was Feb 29; fall back to Feb 28 of the target year.
+        return day.replace(year=day.year + years, day=28)
