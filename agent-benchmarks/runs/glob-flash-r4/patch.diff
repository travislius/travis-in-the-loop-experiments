+"""Glob matching for slash-separated relative paths.
+
+The syntax is intentionally close to .gitignore globs: wildcards do not cross
+path separators, and ``**`` is special only when it occupies a whole path
+segment.
+"""
+
+
+def _find_class_end(pattern, start):
+    """Return the index of the ``]`` closing the class at *start*, or None."""
+    i = start + 1
+    n = len(pattern)
+
+    if i < n and pattern[i] == '!':
+        i += 1
+
+    # A ']' immediately after '[' or '[!' is a literal member of the class.
+    if i < n and pattern[i] == ']':
+        i += 1
+
+    while i < n:
+        ch = pattern[i]
+        if ch == '\\':
+            i += 2
+        elif ch == ']':
+            return i
+        else:
+            i += 1
+
+    return None
+
+
+def _split_pattern(pattern):
+    """Split a pattern into path segments, respecting escapes and classes."""
+    segments = []
+    current = []
+    i = 0
+    n = len(pattern)
+
+    while i < n:
+        ch = pattern[i]
+
+        if ch == '\\':
+            if i + 1 < n:
+                escaped = pattern[i + 1]
+                if escaped == '/':
+                    # An escaped slash still denotes a real path separator.
+                    segments.append(''.join(current))
+                    current = []
+                else:
+                    current.append(ch)
+                    current.append(escaped)
+                i += 2
+            else:
+                current.append('\\')
+                i += 1
+        elif ch == '/':
+            segments.append(''.join(current))
+            current = []
+            i += 1
+        elif ch == '[':
+            end = _find_class_end(pattern, i)
+            if end is None:
+                current.append('[')
+                i += 1
+            else:
+                current.append(pattern[i:end + 1])
+                i = end + 1
+        else:
+            current.append(ch)
+            i += 1
+
+    segments.append(''.join(current))
+    return segments
+
+
+def _parse_class(content):
+    """Parse the inside of a character class into (negated, items)."""
+    negated = False
+    if content.startswith('!'):
+        negated = True
+        content = content[1:]
+
+    atoms = []
+    i = 0
+    while i < len(content):
+        ch = content[i]
+        if ch == '\\' and i + 1 < len(content):
+            atoms.append((content[i + 1], True))
+            i += 2
+        else:
+            atoms.append((ch, False))
+            i += 1
+
+    items = []
+    i = 0
+    while i < len(atoms):
+        if (
+            i + 2 < len(atoms)
+            and atoms[i + 1][0] == '-'
+            and not atoms[i + 1][1]
+        ):
+            items.append(('range', atoms[i][0], atoms[i + 2][0]))
+            i += 3
+        else:
+            items.append(('char', atoms[i][0]))
+            i += 1
+
+    return negated, items
+
+
+def _parse_segment(segment):
+    """Turn one pattern segment into a list of matching tokens."""
+    tokens = []
+    i = 0
+    n = len(segment)
+
+    while i < n:
+        ch = segment[i]
+
+        if ch == '\\':
+            if i + 1 < n:
+                tokens.append(('lit', segment[i + 1]))
+                i += 2
+            else:
+                tokens.append(('lit', '\\'))
+                i += 1
+        elif ch == '*':
+            tokens.append(('star',))
+            i += 1
+        elif ch == '?':
+            tokens.append(('any',))
+            i += 1
+        elif ch == '[':
+            end = _find_class_end(segment, i)
+            if end is None:
+                tokens.append(('lit', '['))
+                i += 1
+            else:
+                negated, items = _parse_class(segment[i + 1:end])
+                tokens.append(('class', negated, items))
+                i = end + 1
+        else:
+            tokens.append(('lit', ch))
+            i += 1
+
+    return tokens
+
+
+def _class_matches(token, char):
+    _, negated, items = token
+
+    matched = False
+    for item in items:
+        if item[0] == 'char':
+            if char == item[1]:
+                matched = True
+                break
+        else:
+            if item[1] <= char <= item[2]:
+                matched = True
+                break
+
+    return not matched if negated else matched
+
+
+def _token_matches(token, char):
+    kind = token[0]
+
+    if kind == 'lit':
+        return token[1] == char
+
+    # No wildcard or character class may match a path separator.
+    if char == '/':
+        return False
+
+    if kind == 'any':
+        return True
+    if kind == 'class':
+        return _class_matches(token, char)
+
+    return False
+
+
+def _match_segment(pattern_segment, path_segment):
+    """Match a single pattern segment against a single path segment."""
+    tokens = _parse_segment(pattern_segment)
+    length = len(path_segment)
+
+    # next_row[j] means "tokens[i + 1:] match path_segment[j:]".
+    next_row = [False] * (length + 1)
+    next_row[length] = True
+
+    for token in reversed(tokens):
+        row = [False] * (length + 1)
+        if token[0] == 'star':
+            row[length] = next_row[length]
+            for j in range(length - 1, -1, -1):
+                row[j] = next_row[j] or (
+                    path_segment[j] != '/' and row[j + 1]
+                )
+        else:
+            for j in range(length - 1, -1, -1):
+                row[j] = (
+                    _token_matches(token, path_segment[j])
+                    and next_row[j + 1]
+                )
+        next_row = row
+
+    return next_row[0]
+
